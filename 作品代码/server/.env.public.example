NODE_ENV=production
DEMO_MODE=true
PUBLIC_API_READONLY=true
JUDGE_ACCOUNT_PHONE=13800138001
JUDGE_ACCOUNT_PASSWORD=123

# Render/Railway/Fly normally inject PORT automatically.
# HOST is auto-detected as 0.0.0.0 when PUBLIC_API_BASE_URL is set.
PUBLIC_API_BASE_URL=https://your-api-domain.example.com

# Optional: restrict browser callers after you have the final frontend URLs.
# Comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://your-frontend-domain.example.com,https://www.coze.cn

# Optional: only needed if you later allow external workflow writes.
# Keep PUBLIC_API_READONLY=false and send this in x-api-key or x-coze-webhook-secret.
COZE_WEBHOOK_SECRET=change-me
